DROP TABLE IF EXISTS bronze_physicians ; 
CREATE TABLE bronze_physicians
(
	physician_id VARCHAR (50),
    physician_name VARCHAR (50),
    credentials VARCHAR (50),
    speciality VARCHAR (50),
    department_id VARCHAR (50),
