DROP TABLE IF EXISTS bronze_nurses ;
CREATE TABLE bronze_nurses
(
	nurse_id VARCHAR (50),
    nurse_name VARCHAR (50),
    credentials VARCHAR (50),
    department_id VARCHAR (50),
    shift VARCHAR (50),
    phone VARCHAR (50),
