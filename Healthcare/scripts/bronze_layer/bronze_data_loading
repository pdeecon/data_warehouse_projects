-- BRONZE DATA LOADING

-- Loaded raw healthcare CSV datasets into the Bronze layer using MySQL LOAD DATA INFILE, covering patients, appointments, billing, diagnoses, medications, prescriptions, rooms, nurses, and physicians.

-- Implemented a repeatable data-loading process by using TRUNCATE TABLE before each load, ensuring the Bronze tables are cleared before importing fresh source data.

-- Configured CSV ingestion parameters using FIELDS TERMINATED BY ',', ENCLOSED BY '"', LINES TERMINATED BY '\n', and IGNORE 1 ROWS to correctly parse CSV files and exclude header rows.


-- Loading the data to bronze appointment visits table
TRUNCATE TABLE bronze_appointment_visits;
	LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 8.0/Uploads/healthcare_datasets/appointments_visits.csv'
	INTO TABLE bronze_appointment_visits
	FIELDS TERMINATED BY ','
	ENCLOSED BY '"'
	LINES TERMINATED BY '\n'
	IGNORE 1 ROWS;

